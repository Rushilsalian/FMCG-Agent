# Gemini API key from https://aistudio.google.com/apikey (keep it server-side only)
GEMINI_API_KEY=
# Any Gemini model that supports function calling (e.g. gemini-3.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash
# Set to "mock" to force the offline MockLLM even if a key is present
LLM_PROVIDER=
PORT=3000
